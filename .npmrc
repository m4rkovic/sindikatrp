# better-sqlite3 isporučuje gotov prebuilds/win32-x64.node binarnik, ali npm
# na Windows-u svejedno pokreće node-gyp kompajlaciju koja traži Visual Studio.
# Ovim je "npm install" preskače — lifecycle skripte nisu potrebne nijednom
# paketu u projektu, a "npm run dev/build/start" radi normalno.
ignore-scripts=true
